+    // Boundary transfers reuse existing events and FP32 scratch; no extra UB.
+    // These synchronous transfers finish before the state scratch is recycled.
+    __aicore__ inline void LoadBoundary(AscendC::LocalTensor<float> dst, int64_t offset, uint32_t elems)
